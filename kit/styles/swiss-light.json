{
  "id": "swiss-light",
  "extends": "_base",
  "description": "B — светлый швейцарский: тёплый светлый фон, строгая сетка, контрастная чёрная типографика, один насыщенный цвет панелями. Почти без скруглений, жирная линейка.",
  "color": {
    "bg": "#F5F3EE", "surface": "#FFFFFF", "ink": "#111111", "muted": "#555555", "light": "#FFFFFF",
    "brand": "#1849FF", "accent": "#1849FF",
    "correct": "#1E8C4E", "wrong": "#E5342B",
    "quiz": "#1849FF", "reward": "#FFF1C7",
    "pos": { "noun": "#1849FF", "verb": "#E5342B", "adj": "#1E8C4E", "other": "#7A3FF2" },
    "shadow": "#111111",
    "line": "#111111"
  },
  "type": {
    "font": { "display": "Inter-Bold", "hero": "Inter-Black", "text": "Inter-Medium" },
    "tracking": { "hero": -40, "h1": -15, "body": 0, "label": 80 },
    "labels": "caps"
  },
  "shape": {
    "radius": { "card": 4, "chip": 4 },
    "stroke": { "thin": 2, "main": 3, "accent": 6, "underline": 3, "stickerOutline": 0 },
    "shadow": "none",
    "imageMask": "rect",
    "imageFrame": "none",
    "background": "bg.panel",
    "sticker": "none"
  },
  "motion": {
    "overshoot": 0,
    "ease": { "enter": "expoOut", "move": "expoInOut" },
    "text": "text.maskUp",
    "word": "text.letters",
    "image": ["image.maskReveal", "image.kenBurns"],
    "transition": "trans.shapeWipe",
    "emphasis": "draw.underline"
  }
}
