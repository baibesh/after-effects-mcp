{
  "name": "ae-mcp",
  "version": "0.1.0",
  "description": "MCP-сервер Adobe After Effects (macOS): высокоуровневые инструменты, запуск через DoScriptFile",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --outdir=build --packages=external",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "ae": "node build/cli.js",
    "validate": "node tools/validate.mjs kit mcp",
    "matchnames": "node tools/build-matchnames.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "types-for-adobe": "^7.2.6"
  },
  "bin": {
    "ae-mcp": "build/index.js"
  }
}
